{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "s3m-three": ["../packages/s3m-three/src/index.ts"]
    }
  },
  "include": ["unit/**/*.ts", "e2e/**/*.ts", "helpers/**/*.ts", "types/**/*.ts"]
}
