{
  "name": "s3m-three",
  "version": "0.4.25",
  "description": "SuperMap S3M 三维模型格式的 three.js 渲染内核：浏览器内直接解析 .s3mb 瓦片，无需转 3D Tiles，支持 LOD 调度、白膜/按高度/按单体/动态扫描着色、单体级 GPU 拾取。宿主无关，可单独用于任意 three 场景。",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joo1es/s3m-maplibre.git"
  },
  "homepage": "https://github.com/joo1es/s3m-maplibre/tree/main/packages/s3m-three#readme",
  "bugs": {
    "url": "https://github.com/joo1es/s3m-maplibre/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/browser/s3m-three.iife.js",
  "jsdelivr": "./dist/browser/s3m-three.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/S3MBParser.d.ts",
      "import": "./dist/core/S3MBParser.js",
      "default": "./dist/core/S3MBParser.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node ../../tools/copy-assets.mjs s3m-three && vite build --config vite.worker.config.ts && vite build --config vite.browser.config.ts && vite build --config vite.browser.config.ts --mode ext",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "keywords": [
    "s3m",
    "s3mb",
    "supermap",
    "iserver",
    "three",
    "threejs",
    "webgl",
    "3d-tiles",
    "gis",
    "bim",
    "photogrammetry"
  ],
  "author": "",
  "license": "Apache-2.0",
  "peerDependencies": {
    "three": ">=0.155.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": false
    }
  }
}
