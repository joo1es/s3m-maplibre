{
  "name": "s3m-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "SuperMap S3M 渲染库 monorepo：packages/s3m-three（three.js 渲染内核，宿主无关）+ packages/s3m-maplibre（MapLibre / Mapbox 适配层）",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "bun run build:three && bun run build:maplibre && bun run build:docs && bun run build:demo",
    "build:three": "bun run --cwd packages/s3m-three build",
    "build:maplibre": "bun run --cwd packages/s3m-maplibre build",
    "build:docs": "node site/scripts/build-docs.mjs",
    "build:demo": "node site/scripts/build-demo.mjs",
    "dev": "node site/scripts/dev.mjs",
    "serve": "node tools/serve.mjs",
    "demo": "bun run build && node tools/serve.mjs",
    "clean": "bun run --cwd packages/s3m-three clean && bun run --cwd packages/s3m-maplibre clean",
    "typecheck": "bun run --cwd packages/s3m-three typecheck && bun run --cwd packages/s3m-maplibre typecheck",
    "test": "bun test",
    "test:unit": "bun test ./tests/unit",
    "test:watch": "bun test --watch",
    "test:coverage": "bun test --coverage",
    "test:e2e": "bun test ./tests/e2e",
    "test:meshopt": "bun run build:three && node tools/meshopt-check.mjs --preset shenyin",
    "test:oracle": "node tools/official-oracle.mjs",
    "probe:parse": "bun run build:three && node tools/parse-sample.mjs",
    "probe:crn": "bun run build:three && node tools/crn-probe.mjs",
    "probe:lod": "bun run build:three && node tools/lod-probe.mjs",
    "probe:trace": "bun run build:three && node tools/trace-one.mjs",
    "prepublishOnly:three": "cd packages/s3m-three && npm publish",
    "prepublishOnly:maplibre": "cd packages/s3m-maplibre && npm publish"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.2.0",
    "@types/three": "^0.169.0",
    "maplibre-gl": "^5.0.0",
    "markdown-it": "^15.0.3",
    "shiki": "^4.5.0",
    "solid-js": "^1.9.17",
    "three": "^0.169.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vite-plugin-solid": "^2.11.14"
  },
  "author": "",
  "license": "Apache-2.0"
}
